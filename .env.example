# Copy this file to .env and fill in real values. Never commit .env.
# Code reads these only through backend/src/config/environmentConfig.js.

# --- Server ---
NODE_ENV=development
PORT=4000
# Comma-separated list of browser origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- PostgreSQL (docker-compose service "postgres") ---
POSTGRES_USER=saad
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=saad
# Connection string used by the connection pool (backend/src/db/databasePool.js)
DATABASE_URL=postgres://saad:change-me-local-only@localhost:5433/saad
TEST_DATABASE_URL=postgres://saad:change-me-local-only@localhost:5433/saad_test

# --- Authentication ---
# Sessions are opaque random tokens stored hashed in the sessions table (3-day HttpOnly cookie).
# No JWT secret is needed. The cookie name and lifetime are fixed in environmentConfig.js.
# Base URL of the staff app; staff invitation links point here. Defaults to the first CORS origin.
STAFF_APP_BASE_URL=http://localhost:5173

# --- Proxy: set to 1 when the API runs behind a load balancer so the real client IP is used ---
TRUST_PROXY_HOP_COUNT=0

# --- Geo-IP lookup (customer origin detection) ---
GEO_IP_LOOKUP_BASE_URL=https://ipwho.is
# Optional key, only if the chosen geo-IP provider requires one
GEO_IP_API_KEY=
REST_COUNTRIES_BASE_URL=https://restcountries.com/v3.1

# --- External e-commerce mock (DummyJSON, used from week 3) ---
DUMMYJSON_BASE_URL=https://dummyjson.com

# --- AI (OpenRouter, used from week 2) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
