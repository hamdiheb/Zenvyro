# Copy to frontend/.env and adjust. Only VITE_ variables reach the browser, so never put secrets here.

# Backend origin used by the Vite dev proxy for /api and /socket.io.
VITE_BACKEND_ORIGIN=http://localhost:4000

# Widget key the /demo-store page embeds (see businesses.widget_key, format wk_ + 32 hex characters).
# This is the key backend/db/seed.sql gives the Acme Shoes demo business.
VITE_DEMO_WIDGET_KEY=wk_ace5ace5ace5ace5ace5ace5ace5ace5
